rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isStoryAuthor() {
      return signedIn() && resource.data.authorId == request.auth.uid;
    }

    function isIncomingStoryAuthor() {
      return signedIn() && request.resource.data.authorId == request.auth.uid;
    }

    function isLinkedParent() {
      return signedIn() &&
        resource.data.parentEmail is string &&
        resource.data.parentEmail == userEmail();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId);
    }

    match /stories/{storyId} {
      allow read: if signedIn() && (
        resource.data.status == 'published' ||
        isStoryAuthor() ||
        isLinkedParent()
      );

      allow create: if isIncomingStoryAuthor();

      allow update: if signedIn();
      allow delete: if isStoryAuthor();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() &&
        resource.data.toUserId == request.auth.uid;

      allow create: if signedIn();
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }
  }
}
