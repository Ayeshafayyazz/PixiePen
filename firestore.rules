rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isStoryAuthor() {
      return signedIn() && resource.data.authorId == request.auth.uid;
    }

    function isIncomingStoryAuthor() {
      return signedIn() && request.resource.data.authorId == request.auth.uid;
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isParentAccount() {
      return signedIn() && currentUserData().role == 'parent';
    }

    function isLinkedParent() {
      return signedIn() &&
        resource.data.parentEmail is string &&
        resource.data.parentEmail == userEmail();
    }

    function changedStoryKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function authorKeepsOwnership() {
      return !('authorId' in resource.data) ||
        request.resource.data.authorId == resource.data.authorId;
    }

    function isStorySaver() {
      return signedIn() &&
        resource.data.get('savedBy', []) is list &&
        request.auth.uid in resource.data.get('savedBy', []);
    }

    function isAuthorStoryUpdate() {
      return isStoryAuthor() &&
        authorKeepsOwnership() &&
        (
          isParentAccount() ||
          request.resource.data.status in ['draft', 'pending_parent_approval']
        );
    }

    function isLinkedParentApprovalUpdate() {
      return isLinkedParent() &&
        authorKeepsOwnership() &&
        changedStoryKeys().hasOnly([
          'status',
          'isPublish',
          'approvalStatus',
          'parentApproval',
          'parentFeedback',
          'updatedAt'
        ]);
    }

    function isEngagementUpdate() {
      return signedIn() &&
        authorKeepsOwnership() &&
        changedStoryKeys().hasOnly([
          'likes',
          'likedBy',
          'comments',
          'ratingTotal',
          'ratingCount',
          'averageRating',
          'saves',
          'savedBy'
        ]);
    }

    function isAuthorIdentityUpdate() {
      return isStoryAuthor() &&
        authorKeepsOwnership() &&
        changedStoryKeys().hasOnly([
          'authorName',
          'username',
          'handle',
          'updatedAt'
        ]);
    }

    function isValidRating() {
      return request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
    }

    function isSavedStoryOwner() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function isValidSavedStoryCreate(savedId) {
      return signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.storyId is string &&
        request.resource.data.storyId.size() > 0 &&
        savedId == request.auth.uid + '_' + request.resource.data.storyId;
    }

    function isValidSavedStoryUpdate() {
      return isSavedStoryOwner() &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.storyId == resource.data.storyId;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId);
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.followerId == request.auth.uid &&
        request.resource.data.targetId is string &&
        request.resource.data.targetId != request.auth.uid &&
        followId == request.auth.uid + '_' + request.resource.data.targetId &&
        request.resource.data.keys().hasOnly([
          'followerId',
          'targetId',
          'createdAt'
        ]);
      allow update: if false;
      allow delete: if signedIn() &&
        resource.data.followerId == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if signedIn() && (
        resource.data.status == 'published' ||
        isStoryAuthor() ||
        isLinkedParent() ||
        isStorySaver()
      );

      allow create: if isIncomingStoryAuthor() &&
        (
          isParentAccount() ||
          request.resource.data.status in ['draft', 'pending_parent_approval']
        );

      allow update: if isAuthorStoryUpdate() ||
        isLinkedParentApprovalUpdate() ||
        isAuthorIdentityUpdate() ||
        isEngagementUpdate();
      allow delete: if isStoryAuthor();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update: if signedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'commentReactions',
            'reactionCounts',
            'reactionsByUser',
            'replies',
            'replyCount',
            'updatedAt'
          ]);
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;

        match /reactions/{userId} {
          allow read: if signedIn();
          allow create, update, delete: if isOwner(userId);
        }
      }

      match /ratings/{userId} {
        allow read: if signedIn();
        allow create, update: if isOwner(userId) && isValidRating();
        allow delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() &&
        resource.data.toUserId == request.auth.uid;

      allow delete: if signedIn() &&
        resource.data.toUserId == request.auth.uid;

      allow create: if signedIn();
    }

    match /storyLikes/{likeId} {
      allow read: if signedIn();
      allow create, update: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() &&
        resource.data.userId == request.auth.uid;
    }

    match /savedStories/{savedId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.authorId == request.auth.uid
      );
      allow create: if isValidSavedStoryCreate(savedId);
      allow update: if isValidSavedStoryUpdate();
      allow delete: if isSavedStoryOwner();
    }

    match /ebooks/{ebookId} {
      allow read, update, delete: if signedIn() &&
        resource.data.userId == request.auth.uid;

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }
  }
}
